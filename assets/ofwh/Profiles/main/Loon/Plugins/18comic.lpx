[Rule]
URL-REGEX,^https://([^/]*)\/ad-provider\.js, REJECT
URL-REGEX,^https://18comic\.(vip|org)\/cdn-cgi\/rum, REJECT

[Script]
http-response ^https?:\/\/18comic\.(vip|org)\/.* script-path=https://raw.bofoi.com/assets/ofwh/Profiles/main/Loon/Scripts/18comic.js, requires-body=true, tag=禁漫天堂去广告

[MitM]
hostname = 18comic.vip,18comic.org
