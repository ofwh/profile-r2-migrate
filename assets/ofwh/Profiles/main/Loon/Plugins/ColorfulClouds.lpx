#!name=彩云天气去广告
#!desc=移除首页推广、弹窗、悬浮窗、底栏天气助手和工具箱入口，移除我的页面广告横幅。
#!openUrl=https://apps.apple.com/app/id847764912
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/ColorfulClouds.png

[Rule]
DOMAIN, abyss.cyapi.cn, REJECT
DOMAIN, ad.cyapi.cn, REJECT
DOMAIN, gather.colorfulclouds.net, REJECT

[Rewrite]
^https:\/\/biz\.cyapi\.cn\/(p\/v1\/entries|p\/v1\/trial_card\/info|v2\/product) reject-dict
^https:\/\/starplucker\.cyapi\.cn\/v3\/(config\/cypage\/\w+\/conditions|notification\/message_center|operation\/homefeatures) reject-dict

[Script]
http-response ^https:\/\/(wrapper\.cyapi\.cn|api\.caiyunapp\.com|cdn-w\.caiyunapp\.com)\/v1\/activity\? script-path=https://cdn.podkit.cn/assets/ofwh/Profiles/main/Loon/Scripts/ColorfulClouds.js, requires-body=true, tag=彩云天气去广告
# http-response ^https?:\/\/biz\.cyapi\.cn\/v\d\/user script-path=https://cdn.podkit.cn/assets/ofwh/Profiles/main/Loon/Scripts/ColorfulClouds.js, requires-body=true, tag=彩云天气VIP解锁
http-response ^https?:\/\/biz\.cyapi\.cn\/ script-path=https://cdn.podkit.cn/assets/curtinp118/Scripthub/main/scripts/caiyun/caiyun.js, requires-body=true, tag=彩云天气VIP解锁

[MitM]
hostname=biz.cyapi.cn, starplucker.cyapi.cn, api.caiyunapp.com, cdn-w.caiyunapp.com
